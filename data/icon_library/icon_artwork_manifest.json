{
  "schema": 1,
  "purpose": "Production manifest for authored attachment icon artwork. No artwork is embedded here.",
  "render_contract": {
    "master_format": "SVG",
    "view_box": "0 0 24 24",
    "target_ui_size_px": 22,
    "safe_area": "2 px from each edge; prefer a 20x20 optical footprint",
    "stroke_width": 1.6,
    "line_cap": "round",
    "line_join": "round",
    "fill_policy": "silhouette-first; solid currentColor bodies with transparent negative-space cutouts; strokes only for secondary detail when needed",
    "color_policy": "monochrome; artwork must be recolorable by the UI",
    "background": "transparent",
    "detail_rule": "one dominant silhouette and at most two secondary details; must remain readable at 22x22",
    "brand_rule": "generic shapes only; no logos, text, trademarks, or exact branded product geometry",
    "source_rule": "original authored artwork only; do not trace or redistribute third-party icon assets",
    "style_reference": "Established FallUI/FIS icon-library visual language: compact monochrome symbols, strong silhouettes, restrained detail, recolorable UI presentation; original artwork only."
  },
