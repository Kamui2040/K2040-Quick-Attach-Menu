{
  "modName": "K2040_Quick_Attach_Menu",
  "displayName": "K2040's Quick Attach Menu",
  "minMcmVersion": 1,
  "pluginRequirements": [],
  "ownerModName": "K2040_Mods",
  "content": [],
  "pages": [
    {
      "pageDisplayName": "Quick Attach Menu",
      "content": [
        {
          "type": "text",
          "text": "<font size='30'><p align='center'>K2040's Quick Attach Menu</p></font>",
          "html": true
        },
        {
          "type": "text",
          "text": "Configure the shortcuts used by the quick menu and per-weapon menu builder. Registered shortcuts also appear in MCM's Hotkey Manager. Changes apply after leaving MCM."
        },
        {
          "type": "section",
          "text": "Keybindings"
        },
        {
          "id": "openQuickMenu",
          "type": "hotkey",
          "text": "Open / close quick menu",
          "help": "Opens or closes the inventory-limited attachment menu. If the builder is open, this switches to the quick menu. If unassigned, the plugin INI default is used.",
          "valueOptions": {
            "allowModifierKeys": 1
          }
        },
        {
          "type": "section",
          "text": "Quick menu \u2014 controller shortcut"
        },
        {
          "id": "iQuickAttachPadPrimary:Controller",
          "type": "dropdown",
          "text": "Action button",
          "help": "Unbound by default; see Quick Attach Menu's Controls page for the same selection.",
          "valueOptions": {
            "options": [
              "Unbound",
              "A",
              "B",
              "X",
              "Y",
              "D-pad Up",
              "D-pad Down",
              "D-pad Left",
              "D-pad Right",
              "LB",
              "RB",
              "LT",
              "RT",
              "Start",
              "Back",
              "Left Stick",
              "Right Stick"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "iQuickAttachPadModifier:Controller",
          "type": "dropdown",
          "text": "Optional held button",
          "help": "Select a button to hold before the action, for example LB+RB or LT+D-pad Up.",
          "valueOptions": {
            "options": [
              "Unbound",
              "A",
              "B",
              "X",
              "Y",
              "D-pad Up",
              "D-pad Down",
              "D-pad Left",
              "D-pad Right",
              "LB",
              "RB",
              "LT",
              "RT",
              "Start",
              "Back",
              "Left Stick",
              "Right Stick"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "openMenuBuilder",
          "type": "hotkey",
          "text": "Open / close menu builder",
          "help": "Opens or closes the per-weapon builder. If the quick menu is open, this switches to the builder. If unassigned, the plugin INI default is used. Escape closes either menu.",
          "valueOptions": {
            "allowModifierKeys": 1
          }
        },
        {
          "type": "section",
          "text": "Settings"
        },
        {
          "type": "text",
          "text": "Open the menu builder and choose Settings for appearance, layouts, behavior, label controls, and a mirror of these shared keybindings. Per-weapon visibility, menu-source overrides, order, and labels remain in the builder."
        }
      ]
    }
  ]
}
